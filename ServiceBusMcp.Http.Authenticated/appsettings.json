{
  "ServiceBus": {
    "Namespace": "servicebus-resource-name.servicebus.windows.net",
    "AllowedQueues": [
      "queue-101",
      "queue-102"
    ],
    "AllowedReplayQueues": [
      "queue-101"
    ]
  },
  "TryConnectOnStartup": true,
  "EntraId": {
    "Authority": "https://login.microsoftonline.com/{entra-tenant-id}/v2.0",
    "ClientId": "{entra-client-id}",
    "ClientSecret": "{entra-client-secret}",
    "TenantId": "{entra-tenant-id}"
  },
  "Authorization": {
    "RequiredGroupId": "{entra-group-id}"
  }
}
